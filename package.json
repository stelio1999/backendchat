{
  "name": "whatsapp-clone-backend",
  "version": "1.0.0",
  "description": "Backend do WhatsApp Clone em Node.js",
  "main": "dist/app.js",
  "scripts": {
    "clean": "rimraf dist",
    "build": "rimraf dist && tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "start": "node dist/app.js",
    "db:migrate": "node dist/migrations/run.js",
    "db:seed": "node dist/seeds/run.js"
  },
  "dependencies": {
    "@google/genai": "^2.7.0",
    "@peculiar/webcrypto": "^1.7.1",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-fileupload": "^1.5.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "google-auth-library": "^9.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "pg": "^8.21.0",
    "redis": "^4.6.11",
    "sharp": "^0.33.1",
    "simple-peer": "^9.11.1",
